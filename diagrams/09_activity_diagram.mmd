    classDef battleStyle fill:#F0FDFA,stroke:#0D9488,stroke-width:2px,color:#0F172A,font-weight:600;
    classDef winStyle fill:#DCFCE7,stroke:#16A34A,stroke-width:2px,color:#14532D,font-weight:700;
    classDef errorStyle fill:#FEE2E2,stroke:#DC2626,stroke-width:2px,color:#7F1D1D,font-weight:600;